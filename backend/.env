# Monthly digest scheduler — set to "true" to enable in-process cron on 1st of every month at 09:00 IST
ENABLE_DIGEST_SCHEDULER="false"

# Subscription expiry gate — set to "true" to block write actions for schools whose subscription has lapsed.
# Read endpoints, /auth/* and /subscriptions/* stay open so the school can log in and renew.
ENABLE_SUBSCRIPTION_GUARD="true"
# Grace period in days after `valid_until` before writes are blocked (default 3).
SUBSCRIPTION_GRACE_DAYS="3"

# Subscription pricing — change any of these and every consumer (GET /subscriptions/pricing,
# quote endpoint, approval validity window, SchoolSubscription UI) reflects the new values
# without a code change.
SUBSCRIPTION_PRICE_PER_CHILD_MONTHLY="70"
SUBSCRIPTION_PRICE_PER_CHILD_YEARLY="820"
SUBSCRIPTION_MONTHLY_DAYS="30"
SUBSCRIPTION_YEARLY_DAYS="365"
SUBSCRIPTION_CURRENCY="INR"
# Min billed-children count at which the "Switch to yearly and save" banner appears
SUBSCRIPTION_YEARLY_NUDGE_THRESHOLD="50"

# Azure Blob Storage (for student photos, medical certificates, and future PDF assets).
# Leave blank to use in-DB base64 storage. Fill these to migrate uploads to Azure.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER=""
AZURE_STORAGE_ACCOUNT_URL=""

# SMTP — provider-agnostic email channel (Gmail, AWS SES, SendGrid SMTP, Mailgun SMTP, etc.).
# Leave SMTP_HOST blank to keep email notifications queued (no delivery attempt).
