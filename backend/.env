MONGO_URL: "mongodb+srv://jagadish:Chandu123@ssms.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000"
DB_NAME: "${DB_NAME:-scms_db}"

      # --- Auth ---
JWT_SECRET: "${JWT_SECRET:-8be242a1b353d392a12618e6f616885b4cd6b74d9c2790ddd83e8d9963d23178e242f4ed790e5558617c480b7e75a865399e47b300623b148434fe9cb51caf7f}"
      # The ONE Platform Super Admin (provisioned at startup)
ADMIN_EMAIL: "${ADMIN_EMAIL:-jagadishchandu789@gmail.com}"
ADMIN_PASSWORD: "${ADMIN_PASSWORD:-Manasa@123}"

      # --- CORS / Origins ---
      # When the frontend is served from the SAME origin as the backend (via nginx proxy),
      # CORS is technically unnecessary — but listing localhost:3000 keeps it working when
      # you run yarn start locally against the dockerized backend.
      FRONTEND_URL: "${FRONTEND_URL:-http://localhost:3000}"
      CORS_ORIGINS: "${CORS_ORIGINS:-http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000}"

      # --- Feature flags ---
      ENABLE_DIGEST_SCHEDULER: "${ENABLE_DIGEST_SCHEDULER:-false}"
      ENABLE_SUBSCRIPTION_GUARD: "${ENABLE_SUBSCRIPTION_GUARD:-true}"
      SUBSCRIPTION_GRACE_DAYS: "${SUBSCRIPTION_GRACE_DAYS:-3}"

      # --- Subscription pricing (env-driven so every consumer stays in sync) ---
      SUBSCRIPTION_PRICE_PER_CHILD_MONTHLY: "${SUBSCRIPTION_PRICE_PER_CHILD_MONTHLY:-30}"
      SUBSCRIPTION_PRICE_PER_CHILD_YEARLY: "${SUBSCRIPTION_PRICE_PER_CHILD_YEARLY:-300}"
      SUBSCRIPTION_MONTHLY_DAYS: "${SUBSCRIPTION_MONTHLY_DAYS:-30}"
      SUBSCRIPTION_YEARLY_DAYS: "${SUBSCRIPTION_YEARLY_DAYS:-365}"
      SUBSCRIPTION_CURRENCY: "${SUBSCRIPTION_CURRENCY:-INR}"

      # --- Twilio (optional — blank = notifications stay queued) ---
      TWILIO_ACCOUNT_SID: "${TWILIO_ACCOUNT_SID:-}"
      TWILIO_AUTH_TOKEN: "${TWILIO_AUTH_TOKEN:-}"
      TWILIO_WHATSAPP_FROM: "${TWILIO_WHATSAPP_FROM:-}"

      # --- Azure Blob storage (optional — blank = base64 in DB) ---
      AZURE_STORAGE_CONNECTION_STRING: "${AZURE_STORAGE_CONNECTION_STRING:-}"
      AZURE_STORAGE_CONTAINER: "${AZURE_STORAGE_CONTAINER:-}"
      AZURE_STORAGE_ACCOUNT_URL: "${AZURE_STORAGE_ACCOUNT_URL:-}"

      # --- SMTP (optional — blank = emails stay queued) ---
      SMTP_HOST: "${SMTP_HOST:-}"
      SMTP_PORT: "${SMTP_PORT:-587}"
      SMTP_USER: "${SMTP_USER:-}"
      SMTP_PASSWORD: "${SMTP_PASSWORD:-}"
      SMTP_FROM: "${SMTP_FROM:-}"
      SMTP_USE_SSL: "${SMTP_USE_SSL:-false}"

      # --- Meta WhatsApp Business Cloud API (FREE — 1000 conversations/month) ---
      # When set, takes priority over Twilio. Get keys from
      # https://developers.facebook.com → your app → WhatsApp → API Setup.
      META_WHATSAPP_PHONE_ID: "${META_WHATSAPP_PHONE_ID:-}"
      META_WHATSAPP_ACCESS_TOKEN: "${META_WHATSAPP_ACCESS_TOKEN:-}"
      META_WHATSAPP_VERIFY_TOKEN: "${META_WHATSAPP_VERIFY_TOKEN:-}"
      META_WHATSAPP_API_VERSION: "${META_WHATSAPP_API_VERSION:-v21.0}"

      # --- Telegram Bot API (FREE — unlimited). Token from @BotFather on Telegram. ---
      TELEGRAM_BOT_TOKEN: "${TELEGRAM_BOT_TOKEN:-8748483995:AAEhmgdZZ95ytWKTGtozfxTAP4OspGHh_3k}"
      TELEGRAM_WEBHOOK_SECRET: "${TELEGRAM_WEBHOOK_SECRET:-Manasa@123}"
