# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Secrets / env (NEVER commit real values)
.env
.env.*
!.env.example
*.env
!*.env.example
credentials.json
*.pem
*.key
.credentials

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.coverage
.ruff_cache/
.mypy_cache/

# Node / React
node_modules/
frontend/build/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs & runtime
*.log
logs/
/var/log/

# Test artefacts
/app/test_reports/
playwright-report/
test-results/

# Mongo & docker volumes
mongo_data/
data/db/

# Generated assets
*.xlsx~
*.pdf~

