# Files & directories Docker should NOT send to the build context.
# Speeds up builds and keeps secrets out of the image layers.

# Git / IDE
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store

# Secrets (mount via env at runtime instead)
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
.credentials
credentials.json

# Python
**/__pycache__
**/*.pyc
**/*.pyo
.venv
venv
.pytest_cache
.ruff_cache
.coverage

# Node / React
**/node_modules
**/build
**/.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs & test outputs
**/logs
**/*.log
test_reports
playwright-report
test-results

# Local data
mongo_data
data

# Docs (optional — keep README in image; drop heavy dirs)
docs
*.md
!README.md

# Emergent platform internals
.emergent
memory
